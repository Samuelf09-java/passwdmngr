using Gtk 4.0;

template $EntryViewBox: Box {
    orientation: vertical;

    Box content_box {
        orientation: vertical;
        hexpand: true;
        vexpand: true;
        spacing: 12;
        margin-top: 15;
        margin-bottom: 15;
        margin-start: 15;
        margin-end: 15;

        Box service_box {
            orientation: horizontal;
            spacing: 12;
            halign: center;

            Label service_label {
                wrap: true;

                css-classes: [
                    "service",
                ];
            }

            Button service_copy_button {
                icon-name: "edit-copy-symbolic";
                visible: false;
                tooltip-text: "Copy to clipboard";
                has-frame: false;

                css-classes: [
                    "copy-button",
                ];
            }
        }

        Box username_box {
            orientation: horizontal;
            spacing: 12;
            halign: center;

            Label username_label {
                wrap: true;
            }

            Button username_copy_button {
                icon-name: "edit-copy-symbolic";
                visible: false;
                tooltip-text: "Copy to clipboard";
                has-frame: false;

                css-classes: [
                    "copy-button",
                ];
            }
        }

        Box password_box {
            orientation: horizontal;
            spacing: 12;
            halign: center;

            Label password_label {
                wrap: true;
            }

            Button password_copy_button {
                icon-name: "edit-copy-symbolic";
                visible: false;
                tooltip-text: "Copy to clipboard";
                has-frame: false;

                css-classes: [
                    "copy-button",
                ];
            }
        }

        Label notes_title {
            label: _("Notes:");
        }

        Box notes_container {
            orientation: vertical;
            hexpand: false;

            Label notes_label {
                wrap: true;
                wrap-mode: word_char;
                xalign: 0;
                halign: center;
            }

            Button notes_copy_button {
                icon-name: "edit-copy-symbolic";
                visible: false;
                tooltip-text: "Copy to clipboard";
                has-frame: false;
                halign: end;

                css-classes: [
                    "copy-button",
                ];
            }
        }
    }

    Box floating_buttons {
        halign: end;
        valign: end;
        spacing: 12;
        margin-end: 16;
        margin-bottom: 16;

        Button edit_button {
            css-classes: [
                "circular",
            ];

            Image {
                icon-name: "document-edit-symbolic";
            }

            clicked => $on_edit_clicked();
        }

        Button delete_button {
            css-classes: [
                "circular",
            ];

            Image {
                icon-name: "user-trash-symbolic";
            }

            clicked => $on_delete_clicked();
        }
    }
}
